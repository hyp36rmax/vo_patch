// The launcher's icon and version information. The version is the
// launcher's own, not the patcher's: the same signed exe ships with every
// release. Raise it when launcher.c or this file changes.
#include <winver.h>

#define LAUNCHER_PARTS 1,0,0,0
#define LAUNCHER_VERSION "1"

1 ICON "..\\assets\\icon.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION LAUNCHER_PARTS
 PRODUCTVERSION LAUNCHER_PARTS
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "pairomaniac"
            VALUE "FileDescription", "V-On Patcher - Virtual-On (PC, 1997)"
            VALUE "FileVersion", LAUNCHER_VERSION
            VALUE "InternalName", "v-on-patcher"
            VALUE "OriginalFilename", "v-on-patcher.exe"
            VALUE "ProductName", "V-On Patcher"
            VALUE "ProductVersion", LAUNCHER_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
